---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllListings, getPublishedMetros } from '../../lib/listings';
import { breadcrumbJsonLd } from '../../lib/seo';

const listings = getAllListings();
const metros = getPublishedMetros();
const rawBusinessesChecked = 1057;
const totalPrices = listings.reduce((sum, l) => sum + l.pricing.length, 0);

const title = 'About & Verification Methodology | EventRentalCosts.com';
const description = 'Learn how EventRentalCosts.com verifies real party equipment rental prices across 10 US metros using automated snippet-level checks and data auditing.';
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About & Methodology', href: '/about/' },
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About & Pricing Verification Methodology',
  description: description,
  mainEntity: {
    '@type': 'Organization',
    name: 'EventRentalCosts.com',
    url: 'https://eventrentalcosts.com',
    foundingDate: '2026-07-12',
    knowsAbout: [
      'Event Equipment Rental',
      'Tent Rental Pricing',
      'Party Rental Cost Benchmarking',
      'Local Business Price Intelligence',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'contact@eventrentalcosts.com',
      contactType: 'editorial support',
    },
  },
};

const jsonLd = [breadcrumbJsonLd(breadcrumbs), aboutSchema];
---
<BaseLayout title={title} description={description} path="/about/" jsonLd={jsonLd}>
  <div class="container narrow">
    <Breadcrumbs items={breadcrumbs} />
    <h1>About &amp; Verification Methodology</h1>

    <p class="lead">
      EventRentalCosts.com is an independent consumer price intelligence index covering party and event equipment rental rates across {metros.length} major US metro markets ({metros.map((m) => m.meta.name).join(', ')}). We operate with a strict data verification standard: 100% of our published rates are extracted directly from local suppliers' public rate sheets with zero estimation, zero synthetic pricing, and zero sponsored ranking distortion.
    </p>

    <div class="metrics-grid">
      <div class="metric-card">
        <span class="metric-val">{rawBusinessesChecked.toLocaleString()}</span>
        <span class="metric-lbl">Suppliers Audited</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">{listings.length}</span>
        <span class="metric-lbl">Verified Directory Listings</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">{totalPrices.toLocaleString()}</span>
        <span class="metric-lbl">Itemized Price Points</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">{metros.length}</span>
        <span class="metric-lbl">US Metro Markets</span>
      </div>
    </div>

    <h2>1. The Four-Stage Data Verification Funnel</h2>
    <p>
      Unlike quote-arbitrage aggregators that capture customer contact information to sell to contractors as leads, our mission is transparent price discovery. We process local market data through a four-stage pipeline:
    </p>
    <ol>
      <li>
        <strong>Primary Ingestion:</strong> We map all registered party, tent, table, and event equipment rental businesses in each target metropolitan statistical area (MSA) via official business filings and Google Maps place records. We filter out non-inventory businesses such as caterers, DJs, venues, and retail supply stores.
      </li>
      <li>
        <strong>Direct Source Scraping:</strong> We crawl the public inventory and pricing pages directly on each supplier's primary domain. We never rely on third-party scrapers, user forums, or estimated averages.
      </li>
      <li>
        <strong>Snippet-Level Price Matching:</strong> Every price point must match a verbatim sentence or tabular row on the supplier's website. If a company quotes only via private phone consultations or gated forms ("Request a Quote"), their pricing is classified as unverified and omitted from our comparison tables.
      </li>
      <li>
        <strong>Monthly Recertification:</strong> Our automated verification system re-crawls active supplier websites monthly to confirm that rates, delivery fees, and equipment specifications remain live and accurate.
      </li>
    </ol>

    <h2>2. Editorial Independence &amp; Ad Standards</h2>
    <p>
      EventRentalCosts.com maintains full editorial independence:
    </p>
    <ul>
      <li><strong>No Paid Placement:</strong> Listed vendors cannot pay for higher placement in our tables. Table sorting is strictly determined by verified item prices from lowest to highest.</li>
      <li><strong>Objective Fact-Checking:</strong> Policies regarding delivery fees, setup fees, and weekend surcharges are marked "Yes" or "No" only when explicitly documented in writing by the business. When unstated, policies are classified as "Not published" to prevent false assumptions.</li>
      <li><strong>Commercial Model:</strong> To fund server maintenance and ongoing data crawls, the site displays standard context-relevant advertising and may establish transparent referral partnerships. Advertisers have zero editorial influence over pricing data or directory inclusions.</li>
    </ul>

    <h2>3. Corrections &amp; Supplier Updates</h2>
    <p>
      We welcome updates directly from local rental companies. If your company updates its published rate sheet or adjusts seasonal equipment pricing, contact our editorial desk at <a href="mailto:contact@eventrentalcosts.com">contact@eventrentalcosts.com</a>. Corrections are typically validated and deployed within 48 business hours.
    </p>
  </div>
</BaseLayout>

<style>
  .narrow { max-width: 740px; }
  .lead { font-size: 1.15rem; line-height: 1.6; color: var(--color-text); margin-block: var(--space-4) var(--space-6); }
  h2 { margin-top: var(--space-8); margin-bottom: var(--space-3); }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-6);
  }
  .metric-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: center;
  }
  .metric-val {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary, #1e3a8a);
  }
  .metric-lbl {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }
  ol, ul { padding-left: var(--space-6); margin-bottom: var(--space-4); }
  li { margin-bottom: var(--space-2); color: var(--color-text-muted); }
  li strong { color: var(--color-text); }
</style>
