---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getPublishedMetros,
  getUnpagedListings,
  stateAbbr,
  tentSizeBreakdown,
  bounceHousePriceRange,
  photoBoothPriceRange,
  waterSlidePriceRange,
  deliveryFeeRange,
  depositRange,
  chairPriceMin,
  tablePriceRange,
  formatPriceRange,
} from '../../lib/listings';
import { breadcrumbJsonLd, faqPageJsonLd } from '../../lib/seo';
import { dataYear, metroDirectory } from '../../lib/categories';

// The single biggest content gap found in the Fable-5 audit: metro pages and
// listing pages exist, but nothing targets the national head terms ("tent
// rental cost", "how much does a tent rental cost", "wedding tent rental
// cost" — all real Easy-KD volume per keyword-research.md). This page is
// built entirely from real cross-metro data already in listings.json — no
// invented "average cost" numbers, the thing every other cost-guide page
// for this query does.
const metros = getPublishedMetros();
const allListings = metros.flatMap((m) => m.listings);

// Published listings in areas that haven't cleared the metro-page floor yet.
// They're live and in the sitemap either way; linking them here is what stops
// them being orphans with zero internal links pointing at them.
const unpaged = getUnpagedListings();

const tentSizes = tentSizeBreakdown(allListings, 2); // min 2 real data points per size, national scale can afford the bar
const bounceHouse = bounceHousePriceRange(allListings);
const photoBooth = photoBoothPriceRange(allListings);
const waterSlide = waterSlidePriceRange(allListings);
const delivery = deliveryFeeRange(allListings);
const deposit = depositRange(allListings);
const chairMin = chairPriceMin(allListings);
const tableRange = tablePriceRange(allListings);
const tentMin = tentSizes.length ? Math.min(...tentSizes.map((t) => t.low)) : null;
const tentMax = tentSizes.length ? Math.max(...tentSizes.map((t) => t.high)) : null;

const weddingTents = tentSizes.filter((t) => {
  const [w, h] = t.size.split('x').map(Number);
  return w * h >= 800;
});
const weddingMin = weddingTents.length ? Math.min(...weddingTents.map((t) => t.low)) : null;
const weddingMax = weddingTents.length ? Math.max(...weddingTents.map((t) => t.high)) : null;

const fmt = (n: number) => (n % 1 === 0 ? n.toFixed(0) : n.toFixed(2));

// 2026-10-24, striking-distance pass: this page ranked ~19-24 for "tent rental
// cost", "tent rental prices", "how much does it cost to rent a tent" and "tent
// rental companies near me" with 0 clicks. Title now carries the exact head terms
// and the year of the data; the description and first paragraph answer the
// question with typical prices instead of only a min-max range.
const year = dataYear();
const sizeStat = (sz: string) => tentSizes.find((t) => t.size === sz);
const s10 = sizeStat('10x10');
const s20 = sizeStat('20x20');
const s2040 = sizeStat('20x40');
const directory = metroDirectory();
const title = `Tent Rental Cost ${year}: Real Prices by Tent Size`;
const description = s10 && s2040
  ? `A 10x10 tent typically rents for about $${fmt(Math.round(s10.median))} and a 20x40 for about $${fmt(Math.round(s2040.median))}. Real published prices by size from ${allListings.length} rental companies.`
  : `Real published tent rental prices by size from ${allListings.length} rental companies across ${metros.length} US metros.`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tent Rental Cost', href: '/tent-rental-cost/' },
];

const faqs = [
  ...(s10 && s20
    ? [{
        q: 'How much does it cost to rent a tent for a party?',
        a: `For a backyard party, a 10x10 tent typically rents for about $${fmt(Math.round(s10.median))} and a 20x20 (roughly 30-40 guests seated) for about $${fmt(Math.round(s20.median))}, based on real published prices. Delivery, setup and sidewalls are often extra, so ask for the total.`,
      }]
    : []),
  {
    q: 'How much does a tent rental cost?',
    a: tentMin != null
      ? `Based on real published pricing from ${allListings.length} companies across our ${metros.length} metro areas, tent rental starts around $${fmt(tentMin)} and runs up to $${fmt(tentMax!)} or more for the largest sizes. Exact cost depends heavily on tent size, delivery distance, and whether setup is included.`
      : `It depends on tent size, delivery distance, and whether setup is included.`,
  },
  ...(weddingMin != null && weddingMax != null && weddingMax > weddingMin
    ? [{
        q: 'How much does a wedding tent rental cost?',
        a: `Larger tents suited to weddings (20x40 and up, roughly 800+ sq ft) run about $${fmt(weddingMin)}–$${fmt(weddingMax)} based on real rates published by companies in our directory. Final cost depends on exact size, sidewalls, flooring, and delivery distance.`,
      }]
    : []),
  ...(delivery
    ? [{
        q: 'Do tent rental companies charge for delivery?',
        a: `Many do — real published delivery fees in our data range from ${formatPriceRange(delivery, fmt)}, based on ${delivery.count} real published fee${delivery.count === 1 ? '' : 's'}. Some companies include delivery within a set radius instead of charging separately; check each company's listing for their specific policy.`,
      }]
    : []),
  ...(deposit
    ? [{
        q: 'How much is a deposit for tent rental?',
        a: `Real published deposits in our data range from ${formatPriceRange(deposit, fmt)}, based on ${deposit.count} real published deposit amount${deposit.count === 1 ? '' : 's'}. Not every company requires one, and policies vary — check the individual listing.`,
      }]
    : []),
  // "how much do wedding rentals cost" — Easy KD (July 2026 Ahrefs pull);
  // answered as a package view across the real categories we hold data for.
  ...(weddingMin != null && chairMin != null
    ? [{
        q: 'How much do wedding rentals cost?',
        a: `For the core items: wedding-size tents (20x40+) run about $${fmt(weddingMin)}–$${fmt(weddingMax!)}, folding chairs start around $${fmt(chairMin)} each, and 60-inch round tables typically rent per-item on top${photoBooth ? `; photo booths add roughly $${fmt(photoBooth.low)}–$${fmt(photoBooth.high)}` : ''} — all real published rates from companies in our directory.`,
      }]
    : []),
  // "how much does chair rental cost" / "folding chair rental cost" — Easy KD.
  ...(chairMin != null
    ? [{
        q: 'How much does chair rental cost?',
        a: `Folding chairs start around $${fmt(chairMin)} each based on real published rates in our directory, with padded, resin, and chiavari chairs pricing higher per chair. Chair rental is almost always per-item, and many companies have order minimums.`,
      }]
    : []),
  // "table rental cost" — Easy KD (keyword-research.md batch 1). Real data
  // existed all along but only ever surfaced buried in per-listing tables.
  ...(tableRange
    ? [{
        q: 'How much does table rental cost?',
        a: `Real published table prices in our directory run about ${formatPriceRange(tableRange, fmt)} each (${tableRange.count} price point${tableRange.count === 1 ? '' : 's'}), covering banquet, cocktail, round, and specialty tables. Like chairs, tables are almost always priced per-item rather than as part of a package.`,
      }]
    : []),
  ...(photoBooth
    ? [{
        q: 'How much does a photo booth rental cost?',
        a: `Real published photo booth pricing across our directory runs about ${formatPriceRange(photoBooth, fmt)} (${photoBooth.count} price point${photoBooth.count === 1 ? '' : 's'}), with 360 booths and mirror booths above standard enclosed booths. Most quote per event or per hour.`,
      }]
    : []),
  ...(waterSlide
    ? [{
        q: 'How much does a water slide rental cost?',
        a: `About ${formatPriceRange(waterSlide, fmt)} based on real published rates across our directory (${waterSlide.count} price point${waterSlide.count === 1 ? '' : 's'}) — taller dual-lane slides and slide/pool combos sit at the higher end.`,
      }]
    : []),
  {
    q: 'Where can I find tent rental companies near me?',
    a: `We list tent rental companies with their own published prices in ${directory.length} metro areas: ${directory.map((m) => m.name).join('; ')}. Each metro page compares every company side by side.`,
  },
  {
    q: 'How is this pricing data collected?',
    a: `We scrape each rental company's own website directly and extract real dollar figures they've published — we never estimate or fabricate a price. See our methodology page for the full process.`,
  },
];

const jsonLd = [breadcrumbJsonLd(breadcrumbs), faqPageJsonLd(faqs)];
---
<BaseLayout title={title} description={description} path="/tent-rental-cost/" jsonLd={jsonLd}>
  <div class="container narrow">
    <Breadcrumbs items={breadcrumbs} />
    <h1>How much does tent rental cost?</h1>

    <p class="intro">
      {s10 && s20 && s2040 ? (
        <>
          <strong>Short answer:</strong> a small 10x10 tent typically rents for about
          {' '}<strong>${fmt(Math.round(s10.median))}</strong>, a 20x20 for about <strong>${fmt(Math.round(s20.median))}</strong>,
          and a 20x40 (a common wedding size) for about <strong>${fmt(Math.round(s2040.median))}</strong>.
          {' '}
        </>
      ) : null}
      These are the middle of real prices published by tent rental companies on their own
      websites: {allListings.length} companies across {metros.length} US metro areas.
      {tentMin != null && tentMax != null && (
        <> Across every size, published prices run from <strong>${fmt(tentMin)}</strong> for a
        basic pop-up canopy to <strong>${fmt(tentMax)}</strong>+ for the largest frame and pole
        tents. The table below breaks it down by exact size.</>
      )}
    </p>

    {directory.length > 0 && (
      <section class="near-you">
        <h2>Tent rental companies near you</h2>
        <p>
          See every tent rental company we track in your area, with each one's own published
          prices:
          {' '}{directory.map((m, i) => (
            <>
              <a href={`/${m.slug}/`}>{m.name}</a> ({m.companies}){i < directory.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </section>
    )}

    {tentSizes.length > 0 && (
      <section class="size-breakdown">
        <h2>Tent rental cost by size</h2>
        <p class="muted">
          Real prices pulled directly from rental companies' own published rate sheets,
          aggregated across all metros we cover. "Typical" is the middle published price for
          that size. Sizes with only one data point are omitted here —
          see individual metro pages for the full picture in your area.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Tent size</th><th>Typical price</th><th>Published range</th><th>Price points</th></tr>
            </thead>
            <tbody>
              {tentSizes.map((t) => (
                <tr>
                  <td>{t.size} ft</td>
                  <td>${fmt(Math.round(t.median))}</td>
                  <td>{t.low === t.high ? <>${fmt(t.low)}</> : <>${fmt(t.low)}–${fmt(t.high)}</>}</td>
                  <td class="muted">{t.count}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tool-callout">
          Not sure which size you need yet? <a href="https://tools.eventrentalcosts.com/tent-size-calculator/">Use our free tent size calculator</a> — enter your guest count and seating style and it'll tell you the size to look for above.
        </p>
      </section>
    )}

    {weddingMin != null && weddingMax != null && weddingMax > weddingMin && (
      <section>
        <h2>Wedding tent rental cost</h2>
        <p>
          Tents large enough for a wedding (20x40 and up, roughly 800+ square feet) run about
          {' '}<strong>${fmt(weddingMin)}–${fmt(weddingMax)}</strong> based on real published rates.
          Sidewalls, flooring, lighting, and delivery distance all affect the final price — check
          individual company listings for exact line items.
        </p>
      </section>
    )}

    <section>
      <h2>Delivery and deposit costs</h2>
      <p>
        {delivery ? (
          <>Real published delivery fees range from <strong>{formatPriceRange(delivery, fmt)}</strong>
          {' '}({delivery.count} real fee{delivery.count === 1 ? '' : 's'} published across our directory).</>
        ) : (
          <>Delivery fees vary by company and distance.</>
        )}
        {' '}
        {deposit ? (
          <>Where a deposit is required, real published amounts range from
          {' '}<strong>{formatPriceRange(deposit, fmt)}</strong>
          {' '}({deposit.count} real deposit{deposit.count === 1 ? '' : 's'} published).</>
        ) : null}
      </p>
    </section>

    {bounceHouse && (
      <section>
        <h2>Bounce house rental cost (if you need more than a tent)</h2>
        <p>
          Real published bounce house pricing across our directory runs about
          {' '}<strong>{formatPriceRange(bounceHouse, fmt)}</strong>, based on
          {' '}{bounceHouse.count} published price points. Combo units with a slide typically cost
          more than a standalone bounce house. The
          {' '}<a href="/bounce-house-rental-costs/">bounce house rental cost guide</a> breaks
          this down by unit type and by metro.
        </p>
      </section>
    )}

    {photoBooth && (
      <section>
        <h2>Photo booth rental cost</h2>
        <p>
          Real published photo booth pricing across our directory runs about
          {' '}<strong>{formatPriceRange(photoBooth, fmt)}</strong>
          {' '}({photoBooth.count} published price point{photoBooth.count === 1 ? '' : 's'}).
          360 booths and mirror booths typically price above a standard enclosed booth; most
          companies quote per event or per hour.
        </p>
      </section>
    )}

    {waterSlide && (
      <section>
        <h2>Water slide rental cost</h2>
        <p>
          Real published water slide pricing runs about
          {' '}<strong>{formatPriceRange(waterSlide, fmt)}</strong>
          {' '}({waterSlide.count} published price point{waterSlide.count === 1 ? '' : 's'}) —
          taller dual-lane slides and slide/pool combos sit at the higher end.
        </p>
      </section>
    )}

    {(chairMin != null || tableRange) && (
      <section>
        <h2>What about tables and chairs?</h2>
        <p>
          Table and chair rental is almost always priced per-item, not as a package.
          {chairMin != null && (
            <> Real folding chair rates in our data start around <strong>${fmt(chairMin)} each</strong>.</>
          )}
          {tableRange && (
            <>
              {' '}Table prices — banquet, cocktail, round, and more — run{' '}
              <strong>{formatPriceRange(tableRange, fmt)}</strong> each,
              based on {tableRange.count} real published table prices.
            </>
          )}
          {' '}See a metro page below for full per-company pricing tables, or the
          {' '}<a href="/table-and-chair-rental-costs/">table and chair rental cost guide</a> for
          prices by type and by metro.
        </p>
      </section>
    )}

    <section class="faq">
      <h2>Common questions</h2>
      {faqs.map((faq) => (
        <div class="faq-item">
          <h3>{faq.q}</h3>
          <p>
            {faq.a.includes('methodology page') ? (
              <>We scrape each rental company's own website directly and extract real dollar figures
              they've published — we never estimate or fabricate a price. See our
              <a href="/about/">methodology page</a> for the full process.</>
            ) : (
              faq.a
            )}
          </p>
        </div>
      ))}
    </section>

    <section class="metro-links">
      <h2>See real prices where you are</h2>
      <ul>
        {metros.map(({ meta, listings }) => (
          <li><a href={`/${meta.slug}/`}>{meta.name} tent rental prices</a> ({listings.length} companies)</li>
        ))}
      </ul>

      {unpaged.length > 0 && (
        <>
          <h3 id="other-areas">Other areas we have prices for</h3>
          <p class="muted">
            Not enough companies with published pricing in these areas for a full
            city page yet — here's every one we've verified so far.
          </p>
          <ul>
            {unpaged.map((l) => (
              <li>
                <a href={`/listing/${l.slug}/`}>{l.name}</a> — {l.city}, {stateAbbr(l.state)}
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .narrow { max-width: 760px; }
  .intro { color: var(--color-text-muted); margin-bottom: var(--space-6); }
  .near-you { margin-bottom: var(--space-8); }
  .near-you h2 { margin-top: 0; font-size: 1.2rem; }
  h2 { margin-top: var(--space-8); }
  .size-breakdown .muted { color: var(--color-text-muted); margin-bottom: var(--space-3); font-size: 0.9rem; }
  .table-wrap {
    overflow-x: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-4);
  }
  .tool-callout {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }
  .faq-item { margin-bottom: var(--space-6); }
  .faq-item h3 { margin-bottom: var(--space-2); font-size: 1.05rem; }
  .faq-item p { color: var(--color-text-muted); margin: 0; }
  .metro-links ul { padding-left: var(--space-6); }
  .metro-links li { margin-bottom: var(--space-2); }
  .metro-links h3 { margin-top: var(--space-6); margin-bottom: var(--space-2); font-size: 1.05rem; }
  .metro-links .muted { color: var(--color-text-muted); margin: 0 0 var(--space-3); font-size: 0.9rem; }
</style>
