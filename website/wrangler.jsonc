{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventrentalcosts",
  "account_id": "e63d6f768d7b6eb302dfbc1f0b6a10b8",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "routes": [
    { "pattern": "eventrentalcosts.com", "custom_domain": true },
    { "pattern": "www.eventrentalcosts.com", "custom_domain": true }
  ]
}
