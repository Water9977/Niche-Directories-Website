---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { getPublishedMetros } from '../../lib/listings';

const title = 'Terms of Use & Service | EventRentalCosts.com';
const description = 'Read the terms of use for EventRentalCosts.com, covering our independent pricing comparison services, data limitations, and consumer legal guidelines.';
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Terms of Use', href: '/terms/' },
];
const jsonLd = [breadcrumbJsonLd(breadcrumbs)];
const metros = getPublishedMetros();
const lastUpdated = 'November 14, 2026';
---
<BaseLayout title={title} description={description} path="/terms/" jsonLd={jsonLd}>
  <div class="container narrow">
    <Breadcrumbs items={breadcrumbs} />
    <h1>Terms of Use</h1>
    <p class="muted">Last updated: {lastUpdated}</p>

    <h2>1. Overview and Scope of Service</h2>
    <p>
      EventRentalCosts.com operates as an independent, public informational pricing intelligence portal covering party and event equipment rental rates across {metros.length} US metropolitan statistical areas ({metros.map((m) => m.meta.name).join(', ')}). We are not an equipment supplier, event rental vendor, broker, or payment processor. We do not negotiate contracts, manage bookings, or participate in transactions between users and third-party commercial rental providers.
    </p>

    <h2>2. Pricing Accuracy and Informational Disclaimer</h2>
    <p>
      All pricing information presented on EventRentalCosts.com is compiled from publicly accessible supplier catalogs, rate sheets, and online fee schedules. Although we perform routine automated and manual audits to maintain freshness, equipment rates, minimum order sizes, delivery charges, and equipment availability are determined solely by each respective merchant and remain subject to change without prior notice. Users must verify all final quotations and service terms directly with the rental company prior to signing rental agreements or submitting deposits.
    </p>

    <h2>3. Independent Ranking &amp; No Commercial Endorsement</h2>
    <p>
      The display or mention of any local business or trademark on this directory does not constitute an official endorsement, sponsorship, or recommendation by EventRentalCosts.com. Comparison tables are structured strictly by published price thresholds, not financial consideration. We assume no liability for the performance, safety, material quality, or contractual fulfillment of any third-party supplier.
    </p>

    <h2>4. Limitation of Liability</h2>
    <p>
      EventRentalCosts.com and its operators provide this platform on an "as is" and "as available" basis without express or implied warranties. To the maximum extent permitted by applicable law, EventRentalCosts.com disclaims all liability for incidental, direct, indirect, or consequential damages resulting from user reliance on published pricing data or disputes arising with listed vendors.
    </p>

    <h2>5. Inquiries and Legal Contact</h2>
    <p>
      For formal inquiries, corrections, or terms questions, contact our administrative team via email at <a href="mailto:contact@eventrentalcosts.com">contact@eventrentalcosts.com</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .narrow { max-width: 720px; }
  h2 { margin-top: var(--space-8); }
  .muted { color: var(--color-text-muted); }
</style>
