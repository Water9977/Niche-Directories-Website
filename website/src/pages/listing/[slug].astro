---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ThreeStateBadge from '../../components/ThreeStateBadge.astro';
import {
  getAllListings,
  getListingsByMetroKey,
  getMetroForListing,
  stateAbbr,
  comparePricingToPeers,
  pricePosition,
  formatPriceRange,
} from '../../lib/listings';
import { metroByKey } from '../../lib/metros';
import { breadcrumbJsonLd, clampText, localBusinessJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return getAllListings().map((listing) => ({
    params: { slug: listing.slug },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const metro = getMetroForListing(listing);
// Every published listing belongs to a published metro, but fall back gracefully.
const areaHref = metro ? `/${metro.slug}/` : '/';
const areaLabel = metro ? metro.name : 'All metros';

const state = stateAbbr(listing.state);
// Titles/descriptions embed the business name, and a few real names are very
// long, which pushed some listing titles to 98 chars and descriptions to 204 in
// the 2026-09-19 crawl (SERP truncation is ~60 / ~160). Only the name gets
// clamped, so the "Pricing — City, ST" part a searcher scans for always shows.
const titleSuffix = ` Pricing — ${listing.city}, ${state}`;
const title = `${clampText(listing.name, Math.max(20, 60 - titleSuffix.length))}${titleSuffix}`;

const descPrefix = 'Real published pricing for ';
const descTail = ` in ${listing.city}, ${state} — ${listing.pricing.length} verified price point${listing.pricing.length === 1 ? '' : 's'} sourced directly from their own website, not a vague quote.`;
const description = `${descPrefix}${clampText(listing.name, Math.max(20, 160 - descPrefix.length - descTail.length))}${descTail}`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: areaLabel, href: areaHref },
  { label: listing.name, href: `/listing/${listing.slug}/` },
];

const url = `https://eventrentalcosts.com/listing/${listing.slug}/`;
const jsonLd = [breadcrumbJsonLd(breadcrumbs), localBusinessJsonLd(listing, url)];

const lastChecked = listing.pricing
  .map((p) => p.last_checked)
  .filter(Boolean)
  .sort()
  .at(-1);

// A per-listing summary built only from fields already verified for this
// business (category, rating, real pricing count/floor, known policies) —
// every sentence differs by listing since the underlying facts differ.
// Added 2026-08-25 after AdSense flagged the site's content as "low value":
// with 154 listing pages making up most of the site, each one previously
// carried only ~2 sentences of prose around a data table — the exact
// templated/thin-page pattern their content policy calls out. Nothing here
// is invented; it's the same real data already shown, restated as prose.
const cheapestPrice = listing.pricing
  .filter((p) => p.price_low != null)
  .sort((a, b) => a.price_low! - b.price_low!)[0];
const categoryLabel = listing.category?.trim() || 'party and event rental';
const article = /^[aeiou]/i.test(categoryLabel) ? 'an' : 'a';
const overviewParts: string[] = [];
overviewParts.push(
  `${listing.name} is ${article} ${categoryLabel.toLowerCase()} company based in ${listing.city}, ${state}.`,
);
if (listing.rating != null && listing.review_count) {
  overviewParts.push(
    `They hold a ${listing.rating.toFixed(1)}-star average across ${listing.review_count.toLocaleString()} Google review${listing.review_count === 1 ? '' : 's'}.`,
  );
}
overviewParts.push(
  `We've verified ${listing.pricing.length} real price point${listing.pricing.length === 1 ? '' : 's'} published directly on their own website${cheapestPrice?.price_low != null ? `, starting at $${cheapestPrice.price_low.toFixed(0)}${cheapestPrice.unit ? ` ${cheapestPrice.unit}` : ''}` : ''}.`,
);
const knownPolicies: string[] = [];
if (listing.delivery_available !== 'unknown') {
  knownPolicies.push(listing.delivery_available === 'yes' ? 'offer delivery' : "don't offer delivery");
}
if (listing.setup_included !== 'unknown') {
  knownPolicies.push(listing.setup_included === 'yes' ? 'include setup' : "don't include setup");
}
if (listing.weekend_surcharge === 'yes') {
  knownPolicies.push('charge a weekend surcharge');
}
if (knownPolicies.length > 0) {
  overviewParts.push(`Per their published policies, they ${knownPolicies.join(' and ')}.`);
}
const overview = overviewParts.join(' ');

// Real peer comparison against the other companies we track in the same metro
// — see comparePricingToPeers() for why this exists and what it will and won't
// claim. Everything below is computed from prices already verified on both
// sides; a category the peers don't publish simply doesn't appear.
const peers = getListingsByMetroKey(listing.metro).filter((l) => l.slug !== listing.slug);
const nationalPeers = getAllListings().filter((l) => l.slug !== listing.slug);
const comparisons = comparePricingToPeers(listing, peers, nationalPeers);
const positions = comparisons.map(pricePosition);
const belowCount = positions.filter((p) => p === 'below').length;
const withinCount = positions.filter((p) => p === 'within').length;
const aboveCount = positions.filter((p) => p === 'above').length;

// Built as a whole sentence rather than glued-together fragments: when every
// category lands in the same bucket, "land inside the compared range in 3"
// reads like a broken template, and with one category it's worse still.
const n = comparisons.length;
const buckets = [
  { count: belowCount, phrase: 'below the compared range' },
  { count: withinCount, phrase: 'inside the compared range' },
  { count: aboveCount, phrase: 'above the compared range' },
].filter((b) => b.count > 0);

let verdict = '';
if (n === 1 && buckets.length === 1) {
  verdict = `The one category we can compare directly falls ${buckets[0].phrase}.`;
} else if (buckets.length === 1) {
  verdict = `All ${n} categories we can compare directly fall ${buckets[0].phrase}.`;
} else if (buckets.length > 1) {
  const bits = buckets.map((b) => `${b.phrase} in ${b.count}`);
  verdict = `Across the ${n} categories we can compare directly, their published starting prices land ${bits.slice(0, -1).join(', ')}, and ${bits.at(-1)}.`;
}

const fmt = (n: number) => (n % 1 === 0 ? n.toFixed(0) : n.toFixed(2));
---
<BaseLayout title={title} description={description} path={`/listing/${listing.slug}/`} jsonLd={jsonLd} showAds={false}>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <h1>{listing.name}</h1>
    <p class="location">{listing.address}</p>
    <p class="overview">{overview}</p>

    {listing.photo_url && (
      <div class="listing-photo-wrap">
        <img
          class="listing-photo"
          src={listing.photo_url}
          alt={`${listing.name} — party and event rental in ${listing.city}, ${state}`}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="contact-row">
      {listing.phone && <a href={`tel:${listing.phone.replace(/[^0-9+]/g, '')}`} class="button">Call {listing.phone}</a>}
      {listing.website && <a href={listing.website} class="button button-secondary" rel="nofollow noopener" target="_blank">Visit website</a>}
    </div>

    <div class="meta-row">
      {listing.rating != null && listing.review_count ? (
        <span>{listing.rating.toFixed(1)}★ ({listing.review_count} Google reviews)</span>
      ) : null}
      {listing.category && <span class="muted">{listing.category}</span>}
    </div>

    <section class="policies">
      <h2>Policies</h2>
      <dl>
        <dt>Delivery available</dt>
        <dd><ThreeStateBadge value={listing.delivery_available} labelYes="Yes" labelNo="No" /></dd>
        <dt>Setup included</dt>
        <dd><ThreeStateBadge value={listing.setup_included} labelYes="Yes" labelNo="No" /></dd>
        <dt>Weekend surcharge</dt>
        <dd><ThreeStateBadge value={listing.weekend_surcharge} labelYes="Yes" labelNo="No" /></dd>
      </dl>
    </section>

    <section class="pricing">
      <h2>Published pricing</h2>
      {lastChecked && <p class="muted small">Last checked {new Date(lastChecked).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>}
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Item</th><th>Price</th><th>Unit</th></tr>
          </thead>
          <tbody>
            {listing.pricing.map((p) => (
              <tr>
                {/* A few real extractions produce very long compound item
                    names (category-path slugs) — cap display length so one
                    row can't blow up the table. Full context is still on the
                    business's own site via the CTA above. */}
                <td>{(() => { const t = p.item_type.replace(/_/g, ' ').replace(/\s+/g, ' ').trim(); return t.length > 48 ? `${t.slice(0, 47)}…` : t; })()}</td>
                <td>
                  {p.price_low != null ? (
                    p.price_high != null && p.price_high !== p.price_low
                      ? <>${p.price_low.toFixed(0)}–${p.price_high.toFixed(0)}</>
                      : <>${p.price_low.toFixed(0)}</>
                  ) : '—'}
                </td>
                <td class="muted">{p.unit ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small">
        Pricing sourced directly from {listing.name}'s own website. Always confirm current
        pricing and availability with the business before booking — rates can change.
      </p>
    </section>

    {comparisons.length > 0 && (
      <section class="comparison">
        <h2>How {listing.name}'s prices compare</h2>
        <p>
          A price on its own doesn't tell you much. Below, each category
          {listing.name} publishes a real price for is set against what other companies in our
          directory publish for the same thing. Each line says which pool it compares
          against: other {areaLabel} companies where we have local data, or the wider
          directory when they're the only company locally publishing that category. Both
          sides are real published rates we've verified — no estimates — and a category only
          appears when both sides actually publish a number for it.
        </p>
        <ul class="comparison-list">
          {comparisons.map((c) => (
            <li>
              <strong>{c.label}:</strong> {formatPriceRange(c.self, fmt)} here, versus
              {' '}{formatPriceRange(c.peers, fmt)} across the {c.peerCompanies} other
              {' '}{c.peerCompanies === 1 ? 'company' : 'companies'} we track
              {' '}{c.scope === 'local' ? `in ${areaLabel}` : 'nationally'} that
              {' '}{c.peerCompanies === 1 ? 'publishes' : 'publish'} this.
            </li>
          ))}
        </ul>
        {verdict && (
          <p>
            {verdict} Ranges overlap often in this market, so a company sitting inside the
            compared range on most items is the normal case rather than a mark against it — and a
            lower starting price can reflect a smaller or more basic version of the item, not a
            better deal on the same one. Check the exact line items above before drawing a
            conclusion.
          </p>
        )}
      </section>
    )}

    <p class="back-link"><a href={areaHref}>&larr; Back to all {areaLabel} rental companies</a></p>
  </div>
</BaseLayout>

<style>
  .location { color: var(--color-text-muted); margin-bottom: var(--space-4); }
  .overview { max-width: 640px; margin-bottom: var(--space-6); line-height: 1.55; }
  .listing-photo-wrap {
    aspect-ratio: 4 / 3;
    max-width: 408px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    margin-bottom: var(--space-4);
  }
  .listing-photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .contact-row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-4); }
  .meta-row { display: flex; gap: var(--space-4); font-size: 0.9rem; margin-bottom: var(--space-8); }
  .muted { color: var(--color-text-muted); }
  .small { font-size: 0.82rem; }
  .policies { margin-bottom: var(--space-8); }
  dl { display: grid; grid-template-columns: auto auto; gap: var(--space-2) var(--space-6); align-items: center; }
  dt { color: var(--color-text-muted); font-size: 0.9rem; }
  dd { margin: 0; }
  .pricing { margin-bottom: var(--space-8); }
  .table-wrap {
    overflow-x: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    margin-block: var(--space-3);
  }
  .comparison { margin-bottom: var(--space-8); max-width: 720px; }
  .comparison p { color: var(--color-text-muted); }
  .comparison-list { padding-left: var(--space-6); margin-block: var(--space-4); }
  .comparison-list li { margin-bottom: var(--space-3); color: var(--color-text-muted); }
  .comparison-list strong { color: var(--color-text); }
  .back-link { margin-top: var(--space-8); }
</style>
